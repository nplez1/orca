#!/usr/bin/env sh
# LOCAL(nplez1): a fork-only change must never reach an upstream-bound branch.
#
# Upstream-bound branches are cut from upstream/main, so a fork-only file committed to one is reviewed
# as part of that PR's diff — and the point of LOCAL-PATCHES.md is that these patches are reviewed
# nowhere. `local/open-pr.mjs --upstream` already refuses a `local(` subject and every fork-owned
# path, so this is the earlier, cheaper stop.
#
# It deliberately does NOT refuse `local(` on a fork PR branch. It used to, and the result was worse
# than the mistake it guarded: policy work committed there without the `local(` label at least five
# times (#146, #130, #142, #177, #52), which is an *unlabelled* fork-only change riding a fork PR.
# A fork PR branch descends from main, and that lineage is the line the rule follows — however
# far behind the fork's current tip it is (#319).
#
# The decision is in `local/commit-msg-guard.mjs` because it needs the fork-owned path set that
# `open-pr.mjs` owns, and a second copy of that list in sh would drift. Husky 9 runs hooks with
# `sh -e`, so this file stays sh and delegates.
top="$(git rev-parse --show-toplevel 2>/dev/null)" || top=""
if [ -z "$top" ] || [ ! -f "$top/local/commit-msg-guard.mjs" ]; then
  echo "" >&2
  echo "commit-msg: refusing to commit: this tree carries the fork's commit-msg hook but not the" >&2
  echo "  guard it runs ('local/commit-msg-guard.mjs'). That combination only happens when a" >&2
  echo "  fork-only file has leaked onto an upstream-bound branch." >&2
  echo "  Drop it, and stage the removal so the leak leaves the branch:" >&2
  echo "    git rm .husky/commit-msg      # if it is tracked" >&2
  echo "    rm .husky/commit-msg          # if it is untracked" >&2
  echo "" >&2
  exit 1
fi
if ! command -v node >/dev/null 2>&1; then
  echo "commit-msg: node is not on PATH; the fork-only guard cannot run on this commit." >&2
  exit 0
fi
exec node "$top/local/commit-msg-guard.mjs" "$1"
