{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "jsPlugins": [
    {
      "name": "shadcn",
      "specifier": "@shadcn/lint"
    }
  ],
  "settings": {
    "shadcn": {
      "note": "See docs/STYLEGUIDE.md for the role each token and primitive plays."
    }
  },
  "rules": {},
  "overrides": [
    {
      "files": ["**/src/renderer/**/*.tsx"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"]
          }
        ],
        "shadcn/no-raw-colors": [
          "error",
          {
            "allow": ["shadow-floating"]
          }
        ],
        "shadcn/require-static-classes": "error"
      }
    },
    {
      "files": ["**/*.test.tsx"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    // Provider brand marks: every raw color in this module is a vendor's logo fill (the
    // Fireworks mark's #6720FF among them), so a theme token or currentColor would render
    // the mark in the wrong color. Exempted here rather than with an inline directive
    // because the root lint scan does not load this plugin, so an inline directive always
    // reads back as an unused directive there.
    {
      "files": ["**/src/renderer/src/components/status-bar/icons.tsx"],
      "rules": {
        "shadcn/no-raw-colors": "off"
      }
    }
  ],
  "ignorePatterns": ["**/node_modules", "**/dist", "**/out", "cloud/**", "mobile/**"]
}
